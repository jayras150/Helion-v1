# Environment
NODE_ENV=development

# Database (required)
# PostgreSQL connection string - local or hosted (e.g., Vercel Postgres, Neon, Supabase)
POSTGRES_URL=

# Authentication (required)
# Generate with: openssl rand -base64 32
# Note: In development, a default secret is used if not set
AUTH_SECRET=

# AI Provider (required - your own key, no Vercel/v0 dependency)
# Works with OpenAI and any OpenAI-compatible endpoint
# (OpenAI, DeepSeek, Groq, Together, OpenRouter, Ollama, local proxies, etc.)
AI_API_KEY=

# Optional: Custom base URL for OpenAI-compatible APIs
# Leave empty to use https://api.openai.com/v1
# Examples:
#   DeepSeek:   https://api.deepseek.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   Together:   https://api.together.xyz/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
AI_BASE_URL=

# Optional: Model to use (defaults to gpt-4o-mini)
# Examples: gpt-4o, gpt-4o-mini, deepseek-v4-flash, llama-3.3-70b-versatile, ...
AI_MODEL=

# E2B Sandbox (optional - required only for backend/fullstack projects)
# Get your key at https://e2b.dev/dashboard -> Keys
E2B_API_KEY=

# OAuth providers (optional - enables "Sign in with Google / GitHub")
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub: https://github.com/settings/developers
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Supabase (optional - for migration Neon + NextAuth ke Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional - background generation jobs)
# Saat diisi, tiap pesan chat diproses sebagai background job (generasi AI
# tetap selesai walau browser ditutup / idle; client poll hasilnya). Ambil
# URL + token di https://console.upstash.com/redis (REST API). Tanpa ini,
# chat streaming biasa.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (recommended - durable background generation delivery)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public deployment URL, e.g. https://helion-v1.vercel.app
APP_URL=
